#!/usr/bin/env python3

import os
import subprocess
import sys
from typing import Optional

class GitWorkflow:
    
    def __init__(self, branch_name: str, upstream_url: str = "https://github.com/ModelEngine-Group/nexent.git"):
        self.branch_name = branch_name
        self.upstream_url = upstream_url
        
    def run_command(self, command: str, check: bool = True) -> bool:
        try:
            print(f"🚀 执行: {command}")
            result = subprocess.run(command, shell=True, check=check, capture_output=True, text=True)
            if result.stdout:
                print(result.stdout)
            return True
        except subprocess.CalledProcessError as e:
            print(f"❌ 命令执行失败: {e}")
            if e.stderr:
                print(f"错误信息: {e.stderr}")
            return False
    
    def check_git_status(self) -> bool:
        print("📊 检查 Git 状态...")
        return self.run_command("git status")
    
    def check_changes(self) -> bool:
        print("\n🔍 检查文件更改...")
        print("=== 更改的文件 ===")
        self.run_command("git status", check=False)
        
        print("\n=== 具体代码变更 ===")
        self.run_command("git diff", check=False)
        return True
    
    def add_files(self, files: str = ".") -> bool:
        print(f"\n📦 添加文件到暂存区: {files}")
        return self.run_command(f"git add {files}")
    
    def commit_changes(self, commit_type: str, message: str) -> bool:
        icons = {
            "feat": "✨",
            "fix": "🐛", 
            "docs": "📝",
            "refactor": "♻️",
            "style": "🎨",
            "test": "🧪",
            "chore": "🔨",
            "move": "🚚"
        }
        
        icon = icons.get(commit_type, "📝")
        commit_message = f"{icon} {message}"
        
        print(f"\n💾 提交更改: {commit_message}")
        return self.run_command(f'git commit -m "{commit_message}"')
    
    def setup_upstream(self) -> bool:
        print("\n⚙️ 设置上游仓库...")
        
        result = subprocess.run("git remote -v", shell=True, capture_output=True, text=True)
        if "upstream" in result.stdout:
            print("✅ 上游仓库已设置")
            return True
        
        return self.run_command(f"git remote add upstream {self.upstream_url}")
    
    def sync_with_upstream(self) -> bool:
        print("\n🔄 与上游仓库同步...")
        
        commands = [
            "git fetch upstream",
            "git merge upstream/main"
        ]
        
        for cmd in commands:
            if not self.run_command(cmd):
                return False
        
        print("✅ 同步完成")
        return True
    
    def handle_merge_conflicts(self) -> bool:
        print("\n⚠️  检查合并冲突...")
        
        result = subprocess.run("git status", shell=True, capture_output=True, text=True)
        if "both modified" in result.stdout or "conflict" in result.stdout.lower():
            print("🔧 检测到合并冲突，请手动解决:")
            print("1. 编辑冲突文件")
            print("2. 使用 'git add <文件名>' 标记已解决")
            print("3. 使用 'git commit' 完成合并")
            input("按 Enter 键继续解决冲突...")
            return False
        else:
            print("✅ 无合并冲突")
            return True
    
    def push_to_fork(self) -> bool:
        print(f"\n📤 推送分支到 Fork: {self.branch_name}")
        return self.run_command(f"git push origin {self.branch_name}")
    
    def run_complete_workflow(self, commit_type: str, commit_message: str, files: str = ".") -> bool:
        print("=" * 50)
        print("🚀 开始 Git 协作流程")
        print("=" * 50)
        
        steps = [
            ("检查更改", lambda: self.check_changes()),
            ("添加文件", lambda: self.add_files(files)),
            ("提交更改", lambda: self.commit_changes(commit_type, commit_message)),
            ("设置上游", lambda: self.setup_upstream()),
            ("同步上游", lambda: self.sync_with_upstream()),
            ("处理冲突", lambda: self.handle_merge_conflicts()),
            ("推送到Fork", lambda: self.push_to_fork())
        ]
        
        for step_name, step_func in steps:
            print(f"\n{'='*30}")
            print(f"步骤: {step_name}")
            print(f"{'='*30}")
            if not step_func():
                print(f"❌ {step_name} 失败")
                return False
            print(f"✅ {step_name} 完成")
        
        print("\n🎉 所有步骤完成！现在可以去 GitHub 创建 Pull Request 了")
        return True

def main():
    print("Git 协作流程自动化工具")
    print("支持的操作类型:")
    print("  feat     - ✨ 新功能")
    print("  fix      - 🐛 Bug修复") 
    print("  docs     - 📝 文档更新")
    print("  refactor - ♻️ 代码重构")
    print("  style    - 🎨 代码风格")
    print("  test     - 🧪 测试用例")
    print("  chore    - 🔨 工程优化")
    print("  move     - 🚚 代码迁移")
    
    branch_name = input("\n请输入分支名: ").strip()
    commit_type = input("请输入提交类型 (feat/fix/docs等): ").strip()
    commit_message = input("请输入提交消息: ").strip()
    files_to_add = input("请输入要添加的文件 (默认为 '.'): ").strip() or "."
    
    workflow = GitWorkflow(branch_name)
    success = workflow.run_complete_workflow(commit_type, commit_message, files_to_add)
    
    if success:
        print("\n✅ 工作流执行成功！")
    else:
        print("\n❌ 工作流执行失败，请检查错误信息")
        sys.exit(1)

if __name__ == "__main__":
    main()
